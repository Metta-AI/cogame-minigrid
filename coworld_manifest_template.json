                "solved",
                "timeout",
                "died",
                "crashed",
                "unreached"
              ]
            }
          }
        },
        "taskTurns": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "taskTicks": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "taskProgress": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "taskCellsSeen": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "laneTicks": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "deaths": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "crashes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
