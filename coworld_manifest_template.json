          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        },
        "deadSeats": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "stopDetail": {
          "type": "string"
        }
      }
    }
  },
  "player": [
    {
      "id": "scout",
      "type": "player",
      "name": "scout",
      "description": "The published scripted baseline: a deterministic frontier explorer with a goal check. It is also the server-side fallback whenever a seat's LLM call fails twice, so every lane always has a legal plan.",
      "image": "{{MINIGRID_IMAGE}}",
      "run": [
        "/bin/minigrid-player"
      ],
      "source_url": "https://github.com/Metta-AI/cogame-minigrid",
      "env": {
        "PLAYER_SCRIPTED": "scout",
        "PLAYER_POLICY_LABEL": "scout"
      },
      "resources": {
        "requests": {
          "cpu": "100m",
          "memory": "64Mi"
        },
        "limits": {
          "cpu": "1"
        }
      }
    },
    {
      "id": "bumper",
      "type": "player",
      "name": "bumper",
      "description": "The published reactive control: forward if the cell it expects to face is traversable in the map it remembers and is not lava, else turn right. No memory, no BFS, no mission parsing — the floor a real policy has to beat.",
      "image": "{{MINIGRID_IMAGE}}",
      "run": [
        "/bin/minigrid-player"
      ],
      "source_url": "https://github.com/Metta-AI/cogame-minigrid",
      "env": {
        "PLAYER_SCRIPTED": "bumper",
        "PLAYER_POLICY_LABEL": "bumper"
      },
      "resources": {
        "requests": {
          "cpu": "100m",
          "memory": "64Mi"
        },
        "limits": {
          "cpu": "1"
        }
      }
    }
  ],
  "variants": [
    {
      "id": "gauntlet",
      "name": "Gauntlet (4 isolated lanes, 5 MiniGrid tasks)",
      "description": "Five partially observed 13x13 gridworlds, one after another, each with a sentence telling the cog what to do: cross the lava gap, find the yellow key and unlock the door, thread four rooms behind closed doors, fetch the blue ball from a locked side room, and follow one BabyAI instruction. FOUR seats play the SAME five boards at the same moment in four isolated lanes — same seed, same layouts, same missions, no interaction — so the scores are a fair race. Each cog sees only a 7x7 window and gets six turns a phase.",
      "game_config": {
        "players": [
          {
            "name": "Alpha"
          },
          {
            "name": "Beta"
          },
          {
            "name": "Gamma"
          },
          {
            "name": "Delta"
          }
        ],
        "num_agents": 4,
