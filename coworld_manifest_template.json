        "finalTick": {
          "type": "integer"
        },
        "turnsPlayed": {
          "type": "integer"
        },
        "policyKinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "llmTurns": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
