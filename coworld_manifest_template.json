              "gauntletComplete",
              "turnCap",
              "wallClock"
            ]
          }
        },
        "variant": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "taskCount": {
          "type": "integer"
        },
        "parTasks": {
          "type": "integer"
        },
        "cellsTotal": {
          "type": "integer"
        },
        "taskFamilies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "taskMissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phaseTurns": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "tasksSolved": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "progressTotal": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "speedTotal": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "taskSolved": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "boolean"
            }
          }
        },
        "taskOutcome": {
          "type": "array",
          "items": {
            "type": "array",
