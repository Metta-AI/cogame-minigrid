{
  "$schema": "https://softmax.com/schemas/coworld-manifest.json",
  "tags": [
    "gridworld",
    "multi-agent",
    "instruction-following",
    "exploration",
    "minigrid"
  ],
  "episode_timeout_minutes": 20,
  "game": {
    "name": "minigrid",
    "owner": "daveey@softmax.com",
    "description": "Four cogs, each alone in its own private 13x13 walled gridworld it can only see 7x7 of, all four racing the SAME seeded five-task gauntlet at the same moment: cross the lava gap, find the yellow key and unlock the door, thread four rooms behind closed doors, fetch the blue ball from a locked side room, follow a BabyAI instruction, or work out a hidden production rule by pushing objects together. The lanes are isolated — no cog can see, help or block another — so the layouts are identical and the scores compare directly. Five phases, six turns each; the score is how many you solved.",
    "replay_viewer": {
      "bundle": "static-replay-viewer"
    },
    "runnable": {
      "type": "game",
      "image": "{{MINIGRID_IMAGE}}",
      "run": [
        "/bin/minigrid"
      ],
      "source_url": "https://github.com/Metta-AI/cogame-minigrid",
      "env": {
        "ANTHROPIC_API_KEY_URI": "secret://coworld/minigrid/anthropic_api_key"
      }
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/cogame-minigrid/blob/main/docs/PROTOCOL.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/cogame-minigrid/blob/main/docs/PROTOCOL.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/cogame-minigrid/blob/main/README.md"
      },
      "pages": [
        {
          "id": "rules.md",
          "title": "Rules",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/cogame-minigrid/blob/main/docs/RULES.md"
          }
        },
        {
          "id": "actions.md",
          "title": "Actions and the reply format",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/cogame-minigrid/blob/main/docs/ACTIONS.md"
          }
        },
        {
          "id": "porting.md",
          "title": "What this is and is not a port of",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/cogame-minigrid/blob/main/docs/PORTING-MINIGRID.md"
          }
        }
      ]
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "players"
      ],
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "runner-injected seat tokens; never present in a shipped game_config"
        },
        "players": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 0,
          "maxItems": 4
        },
        "taskLadder": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "lavagap",
              "doorkey",
              "multiroom",
              "keycorridor",
              "dynamic",
              "babyai",
              "xland"
            ]
          }
        },
        "gridSize": {
          "type": "integer",
          "minimum": 13,
          "maximum": 13,
          "default": 13
        },
        "viewSize": {
          "type": "integer",
          "minimum": 7,
          "maximum": 7,
          "default": 7
        },
        "turnTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 24
        },
        "taskTurnCap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 6
        },
        "taskCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 5
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "default": 30
        },
        "maxTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000,
          "default": 720
        },
        "parTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 3
        },
        "obstacleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "default": 6
        },
        "xlandRules": {
          "type": "integer",
          "minimum": 3,
          "maximum": 3,
          "default": 3
        },
        "xlandObjects": {
          "type": "integer",
          "minimum": 4,
          "maximum": 8,
          "default": 6
        },
        "babyaiObjects": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8,
          "default": 6
        },
        "maxActionsPerTurn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24,
          "default": 24
        },
        "macroPrimitiveCap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 40
        },
        "spinTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24,
          "default": 24
        },
        "attempt1Ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000,
          "default": 18000
        },
        "retryMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000,
          "default": 12000
        },
        "turnBudgetMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000,
          "default": 30000
        },
        "turnSpacingMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 11000
        },
        "wallClockBudgetSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 660,
          "default": 660
        },
        "lobbyJoinTimeoutTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4800,
          "default": 2400
        },
        "gameOverTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4800,
          "default": 480
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "description": "randomised by the runner; NEVER shown to the seat"
        },
        "minPlayers": {
          "type": "integer",
          "minimum": 4,
          "maximum": 4,
          "default": 4
        },
        "num_agents": {
          "type": "integer",
          "minimum": 4,
          "maximum": 4,
          "default": 4
        },
        "fastMode": {
          "type": "boolean",
          "default": true
        },
        "showPlayerLabels": {
          "type": "boolean",
          "default": false
        },
        "model": {
          "type": "string"
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192,
          "default": 900
        }
      }
    },
    "results_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "win": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "winner": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tied": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": [
            "complete",
            "deadline",
            "fault"
          ]
        },
        "endRule": {
          "type": "string",
          "enum": [
            "allLanesComplete",
            "turnCap",
            "wallClock",
            "fault"
          ]
